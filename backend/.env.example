# Supabase Postgres connection string (Project Settings -> Database -> Connection
# string -> Session pooler or Transaction pooler tab - the direct connection host
# requires IPv6 and often fails to resolve on IPv4-only networks).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Public URL of the deployed frontend - used to build links in outbound emails
# (password reset, grade notifications). Local dev default shown below.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API. Add your Vercel
# domain(s) here in production, e.g.:
#   ALLOWED_ORIGINS=https://conceptintel.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Outbound email (Gmail SMTP with an App Password - free, no third-party signup).
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the Gmail account). Leave both blank to skip email delivery entirely -
# credentials still show up in the admin API response either way.
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password
# Display name shown as the sender in a recipient's inbox, e.g. "ConceptIntel
# <your_gmail_address@gmail.com>" - Gmail SMTP still shows the real address
# alongside this name in most mail clients; it cannot be hidden without a
# custom-domain transactional provider instead of Gmail SMTP.
SMTP_FROM_NAME=ConceptIntel

# Neo4j - AuraDB (console.neo4j.io) or any remote/local Neo4j instance. A driver
# connection string works the same whether it's local (bolt://) or remote/TLS
# (neo4j+s://) - only this value changes, no code does.
NEO4J_URI=neo4j+s://xxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# AI Assistant provider (app/assistant/services.py): "openai", "gemini" or "kimi".
# Only the selected provider's key needs to be real; the others can stay blank.
# NOTE: Google's Generative Language API is geo-blocked in some regions and
# returns "400 FAILED_PRECONDITION: User location is not supported for the API
# use" for every call, including embeddings - a valid GEMINI_API_KEY is not
# enough on its own. If you hit that, use AI_PROVIDER=kimi, which reuses the
# OpenRouter key below. The assistant also falls back to Kimi automatically when
# the selected provider fails at runtime, so a geo-block degrades instead of
# breaking the chatbot.
AI_PROVIDER=kimi
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Kimi K2 via OpenRouter (https://openrouter.ai/keys) - powers the content
# processing pipeline (backend/app/content_processing/kimi_service.py) and
# assignment grading (backend/app/assignments/grading_service.py). For free
# experimentation before buying Kimi credits, set KIMI_MODEL to a free OpenRouter
# model instead (e.g. deepseek/deepseek-chat-v3-0324:free) - same key, same code.
# IMPORTANT: use a non-reasoning K2 model (kimi-k2-0905 or kimi-k2), NOT
# kimi-k2.5 or kimi-k2-thinking. The "Reasoning" variants burn 20-40x more
# tokens on hidden internal "thinking" before answering (confirmed: a trivial
# 3-item JSON request cost $0.0000765 on kimi-k2-0905 vs $0.00166 on kimi-k2.5
# for the identical answer) - worse, that reasoning can exhaust max_tokens
# before the model ever emits real content, returning message.content=None
# and crashing json.loads with a cryptic "not NoneType" error. This app's
# extraction/grading/generation tasks need reliable structured JSON, not
# chain-of-thought - the plain model is both cheaper AND more reliable here.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KIMI_MODEL=moonshotai/kimi-k2-0905

# ---------------------------------------------------------------------------
# RAG / embeddings
#
# Default is fully offline via fastembed (EMBEDDING_PROVIDER=local) - free, no
# API key, no network call, no per-token cost. BAAI/bge-base-en-v1.5 (768-dim)
# is the best-quality model that still runs comfortably in-process; bge-small
# is smaller on disk but retrieves measurably worse. Set EMBEDDING_PROVIDER=
# openrouter to use a hosted model instead (small per-token cost, same
# OPENROUTER_API_KEY as every other AI call here).
#
# EMBEDDING_DIM MUST equal the width of the content_chunks.embedding column.
# There is no Alembic in this project and Base.metadata.create_all() never
# alters an existing column, so changing EMBEDDING_MODEL/EMBEDDING_LOCAL_MODEL
# or EMBEDDING_DIM is a real migration: run `python scripts/reembed_content_chunks.py`,
# which rebuilds the column and re-embeds every chunk from the text already
# stored on uploaded_files.extracted_text. Nothing has to be re-uploaded.
#
# Local (EMBEDDING_PROVIDER=local) pairs:
#   BAAI/bge-base-en-v1.5           768  (default - best free/local quality, ~0.21GB on disk)
#   BAAI/bge-small-en-v1.5          384  (smaller/faster, lower retrieval quality, ~0.07GB on disk)
#   nomic-ai/nomic-embed-text-v1.5-Q 768 (~0.13GB on disk)
# Hosted (EMBEDDING_PROVIDER=openrouter) pairs:
#   openai/text-embedding-3-small  1536  (best hosted quality per cost)
#   openai/text-embedding-3-small   768  (same model, Matryoshka-truncated)
#   baai/bge-m3                    1024  (open model, 8192-token context)
#   openai/text-embedding-3-large  3072  (highest quality, ~6.5x the cost)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=64
EMBEDDING_LOCAL_MODEL=BAAI/bge-base-en-v1.5

# Retrieval tuning. The similarity threshold is applied after the nearest-
# neighbour query, so RAG_CANDIDATE_MULTIPLIER decides how many extra rows are
# fetched first - top_k * multiplier - to stop a strict threshold from silently
# returning fewer results than requested.
#
# RAG_SIMILARITY_THRESHOLD is MODEL-SPECIFIC. BGE models (the default local
# embedder above) score much higher across the board than OpenAI's - 0.45 is
# the right cutoff there. Measured on openai/text-embedding-3-small instead:
# on-topic passage ~0.62, related-but-different ~0.34, unrelated ~0.13 (use
# 0.30 there). If you switch EMBEDDING_MODEL/EMBEDDING_LOCAL_MODEL to a
# different family, re-measure - a threshold carried over either floods the
# context with junk or returns nothing.
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
RAG_CANDIDATE_MULTIPLIER=4

# Vision model used to caption images found inside uploaded PDFs/PPTX during RAG
# ingestion. Routed through OpenRouter for the same reason as embeddings.
VISION_MODEL=openai/gpt-4o-mini

# Output-token budget for one generated concept game (app/gamification/game_service.py).
# This is the single largest completion in the project - the model writes a whole
# standalone HTML page, which is comfortably 6-10k tokens.
#
# It is also the knob that decides whether the feature fits your OpenRouter balance:
# OpenRouter rejects a request outright with HTTP 402 when the account cannot cover
# the max_tokens RESERVATION, even if the finished page would have used far less.
# Below roughly 8000 the page reliably truncates mid-script and will not run, so
# lowering this is not a real workaround - add credit instead.
GAME_MAX_TOKENS=16000

# Redis - app-level cache only (not used by Airflow). Local default shown below;
# a free-tier hosted Redis (e.g. Upstash - https://upstash.com) works the same
# way, just use its rediss:// URL (note the double-s - TLS) instead:
#   REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Airflow REST API (see infra/airflow/docker-compose.yaml). Default credentials
# match Airflow's default LocalExecutor setup - change if you customize it.
AIRFLOW_BASE_URL=http://localhost:8080/api/v1
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DAG_ID=content_graph_pipeline

# OCR fallback tuning (EasyOCR) - defaults are fine for most cases
OCR_LANGUAGES=en
OCR_MIN_TEXT_LENGTH=20

# Supabase - also used for Auth (GoTrue), Storage, and Postgres (DATABASE_URL above)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=conceptintel-files

# AWS S3 file storage (optional - takes priority over Supabase/local when set).
# Bucket should be PRIVATE (block all public access) - files are only ever read
# back through this backend's authenticated API, never a public URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Langfuse tracing for AI calls (free tier at https://cloud.langfuse.com - Settings
# > API Keys after creating a project). Leave both blank to disable tracing entirely.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry error monitoring (free tier at https://sentry.io - create a Python/FastAPI
# project, copy its DSN). Leave blank to disable entirely.
SENTRY_DSN=

UPLOAD_DIR=uploads
