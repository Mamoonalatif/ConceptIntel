[Unit]
Description=ConceptIntel FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ConceptIntel/backend
Environment="PATH=/home/ubuntu/ConceptIntel/backend/.venv/bin"
EnvironmentFile=/home/ubuntu/ConceptIntel/backend/.env
ExecStart=/home/ubuntu/ConceptIntel/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
