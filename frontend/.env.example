VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Base URL of the backend API, including the /api prefix. Leave unset for
# local dev (defaults to http://localhost:8000/api) - only needs setting when
# deploying the frontend somewhere that isn't talking to a local backend, e.g.
# on Vercel pointed at a Render-hosted backend:
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
